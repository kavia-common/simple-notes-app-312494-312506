# Frontend environment variables (Create React App exposes only REACT_APP_*)

# Optional: override backend base URL (defaults to http://localhost:3001)
# Examples:
#   REACT_APP_API_BASE=https://vscode-internal-xxxx.beta01.cloud.kavia.ai:3001
#   REACT_APP_API_BASE=http://localhost:3001
REACT_APP_API_BASE=http://localhost:3001
